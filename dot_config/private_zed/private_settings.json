// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // vscode keymap
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "existing_window",

  // ----------------------- theme settings -----------------------
  // material icon
  "icon_theme": "Material Icon Theme",
  // theme
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  // font
  "ui_font_family": "Liga SFMono Nerd Font",
  "ui_font_size": 15.0,
  "buffer_font_family": "Liga SFMono Nerd Font",
  "buffer_font_size": 15,
  "terminal": {
    "dock": "bottom",
    "font_family": "Liga SFMono Nerd Font",
    "font_size": 15,
  },
  "markdown_preview": {
    "code_font_family": "Liga SFMono Nerd Font",
    "font_family": "Liga SFMono Nerd Font",
    "font_size": 15,
  },

  // ----------------------- editor settings ----------------------
  // cursor
  "cursor_blink": false,
  "cursor_animation": {
    "enabled": true,
  },
  // scrollbar
  "scrollbar": {
    "show": "system",
  },
  // rainbow indent
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  // line numbers
  "relative_line_numbers": "enabled",
  // code diagnostics
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  // ------------------------ vim settings ------------------------
  // vim
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
  },
  // which_key
  "which_key": {
    "enabled": true,
    "delay_ms": 200,
  },

  // ----------------------- panel settings -----------------------
  // title bar
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
    "show_sign_in": false,
  },
  // tab_bar
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  // toolbar
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  // project panel
  "project_panel": {
    "dock": "left",
  },
  // collaboration panel
  "collaboration_panel": {
    "button": false,
  },
  // git
  "git_panel": {
    "dock": "left",
  },
  // agent
  "agent": {
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": false,
      "effort": "low",
    },
    "default_profile": "ask",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // ----------------------- other settings -----------------------
  // proxy
  "proxy": "socks5://127.0.0.1:1080",
  // trust all workspaces
  "session": {
    "trust_all_worktrees": true,
  },
  // Zed
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
}

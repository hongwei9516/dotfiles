# Alias
alias n='nvim'
alias ll='eza -algh --octal-permissions --git-ignore --icons=auto'
alias lg='lazygit'
alias nf='fastfetch'
alias hr='herdr'

alias tree='eza --tree'

alias todo='tuxedo'

alias ez='nvim $ZDOTDIR/.zshrc'

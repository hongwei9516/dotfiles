# ==========================================
# custom function
# ==========================================
fl() {
  local dir="$HOME/Documents/linux-command/command"
  local -a files
  local selected

  [[ -d $dir ]] || { print -u2 "fl: directory not found: $dir"; return 1 }

  # 递归收集 .md，保留相对 $dir 的路径（含子目录），再去掉 .md 后缀
  files=( "$dir"/**/*.md(.N) )
  (( ${#files} )) || { print -u2 "fl: no markdown files in $dir"; return 1 }
  files=( ${files#"$dir"/} )   # 去前缀 → 相对路径，如 sub/7z
  files=( ${files%.md} )       # 去扩展名

  selected=$(
    export FL_DIR="$dir"
    print -rl -- $files \
      | fzf --prompt='LinuxCommands> ' \
            --preview 'glow -p "$FL_DIR"/{}.md' \
            --preview-window=right,75%
  ) || return 0   # Esc 取消时正常返回

  [[ -n $selected ]] && glow -p "$dir/$selected.md"
}

y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd" || return
  fi
  command rm -f -- "$tmp"
}


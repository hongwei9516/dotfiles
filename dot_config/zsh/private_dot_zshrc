# ==========================================
# Zsh Main Configuration (Modularized)
# ==========================================

CONFIG_DIR="${ZDOTDIR:-$HOME/.config/zsh}"

# 按逻辑依赖顺序依次加载子模块
local -a my_modules=(
  "env.zsh"
  "fzf.zsh"
  "completions.zsh"
  "cli.zsh"
  "plugins.zsh"
  "functions.zsh"
  "alias.zsh"
  "herdr.zsh"
)

for module in "${my_modules[@]}"; do
  [[ -f "$CONFIG_DIR/$module" ]] && source "$CONFIG_DIR/$module"
done
